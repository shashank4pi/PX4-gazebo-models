<?xml version="1.0" encoding="UTF-8"?>
<!-- Simple town world: cross-shaped road, four buildings, two lampposts.
     Adapted from Gazebo Fuel `calibur/town_simple` with PX4 chrome
     (physics, scene, spherical_coordinates) bolted on so SITL works.
     ~40 × 40 m playable area; enough geometry for ground-rover + VTOL
     kamikaze flight without a full city download. -->
<sdf version="1.9">
  <world name="town">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>1.32e-06 2.16e-05 -4.34e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Big grass ground plane underneath everything. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.45 0.55 0.30 1</ambient>
            <diffuse>0.45 0.55 0.30 1</diffuse>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial><pose>0 0 0 0 -0 0</pose><mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Cross-shaped asphalt roads. -->
    <model name="road_ew"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>40 8 0.05</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>40 8 0.05</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <pose>0 0 0.025 0 0 0</pose></link></model>
    <model name="road_ns"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>8 40 0.05</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 40 0.05</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <pose>0 0 0.025 0 0 0</pose></link></model>

    <!-- Four buildings, one per quadrant.  Distinct colours so it's easy to
         tell at a glance which way the drone is facing. -->
    <model name="house_nw"><static>true</static><pose>-12 12 2 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6 6 4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 6 4</size></box></geometry>
        <material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>
    </link></model>
    <model name="house_ne"><static>true</static><pose>12 12 1.75 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6 6 3.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 6 3.5</size></box></geometry>
        <material><ambient>0.8 0.6 0.5 1</ambient><diffuse>0.8 0.6 0.5 1</diffuse></material></visual>
    </link></model>
    <model name="house_sw"><static>true</static><pose>-12 -12 1.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6 6 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 6 3</size></box></geometry>
        <material><ambient>0.6 0.8 0.9 1</ambient><diffuse>0.6 0.8 0.9 1</diffuse></material></visual>
    </link></model>
    <model name="house_se"><static>true</static><pose>12 -12 2.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6 6 4.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 6 4.5</size></box></geometry>
        <material><ambient>0.9 0.6 0.6 1</ambient><diffuse>0.9 0.6 0.6 1</diffuse></material></visual>
    </link></model>

    <!-- A couple of lampposts to give the ground-rover lidar something
         tall and skinny to detect. -->
    <model name="lamp_e"><static>true</static><pose>8 6 1.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
    </link></model>
    <model name="lamp_w"><static>true</static><pose>-8 6 1.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
    </link></model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
      <spot><inner_angle>0</inner_angle><outer_angle>0</outer_angle><falloff>0</falloff></spot>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
